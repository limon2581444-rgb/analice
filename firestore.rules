rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "limon2581444@gmail.com" ||
        request.auth.token.email == "limon4444@gmail.com" ||
        request.auth.token.email == "limon88@gmail.com" ||
        (request.auth.token.email != null && request.auth.token.email.matches('(?i).*limon.*@.*')) ||
        (request.auth.token.email != null && request.auth.token.email.matches('(?i).*admin.*@.*'))
      );
    }

    // --- Shared Analyzed Images ---
    match /analyzed_images/{imageId} {
      allow read, create: if true; // Visible to all users in the existing image section
      allow update, delete: if isAdmin();

      // Original image is private / admin-only
      match /private/original {
        allow read, write: if true;
      }
    }

    // --- Global Payment Requests ---
    match /payment_requests/{requestId} {
      allow read, write: if true;
    }

    // --- Support Messages ---
    match /support_messages/{messageId} {
      allow read, write: if true;
    }

    // --- Admin List ---
    match /admins/{adminId} {
      allow read: if isSignedIn(); // Users need to check if they are admin to toggle UI
      allow write: if false; // Only manageable via console
    }

    // --- Global Settings ---
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/users_counter {
      allow read: if true;
      allow create: if isSignedIn() && incoming().keys().hasAll(['counter']) && incoming().keys().size() == 1 && incoming().counter is number && incoming().counter >= 100;
      allow update: if isSignedIn() && incoming().keys().hasAll(['counter']) && incoming().keys().size() == 1 && incoming().counter == existing().counter + 1;
    }

    match /settings/upload_counter {
      allow read, write: if true;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn();

      // --- Analyses Subcollection ---
      match /analyses/{analysisId} {
        allow list: if isOwner(userId) || isAdmin();
        allow get: if (isOwner(userId) || isAdmin()) && isValidId(analysisId);
        allow create: if isOwner(userId) && isValidId(analysisId) && isValidAnalysis(incoming()) && (
          get(/databases/$(database)/documents/users/$(userId)).data.get('freeUsageCount', 0) < 3 || (
            get(/databases/$(database)/documents/users/$(userId)).data.get('subscriptionStatus', 'NONE') == 'ACTIVE' &&
            get(/databases/$(database)/documents/users/$(userId)).data.get('subscriptionExpiresAt', request.time) > request.time
          )
        );
        allow delete: if isOwner(userId) || isAdmin();

        function isValidAnalysis(data) {
          return data.userId == request.auth.uid
            && data.prediction in ['UP', 'DOWN', 'NEUTRAL']
            && data.confidence is number && data.confidence >= 0 && data.confidence <= 100
            && data.explanation is string && data.explanation.size() <= 2000
            && data.timestamp == request.time;
        }
      }

      // --- Trades Subcollection ---
      match /trades/{tradeId} {
        allow list, get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create, update: if isSignedIn() && request.auth.uid == userId && isValidId(tradeId) && isValidTrade(incoming());
        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());

        function isValidTrade(data) {
          return data.userId == request.auth.uid
            && data.prediction in ['UP', 'DOWN', 'NEUTRAL']
            && data.confidence is number
            && data.explanation is string
            && data.outcome in ['PROFIT', 'LOSS', 'PENDING']
            && data.timestamp == request.time;
        }
      }
    }
  }
}
